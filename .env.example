# Public site origin used for canonical URLs, Open Graph URLs, the sitemap and structured data.
# Safe to expose (NEXT_PUBLIC_*). Set this in the hosting platform's environment for production.
NEXT_PUBLIC_SITE_URL=https://www.kuspurban.com

# --- Contact form email (server-side only: never prefix these with NEXT_PUBLIC_) ---
# Supply the mailbox details from the hosting provider. Leave real values out of Git; set them in the host's environment.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: sender address (must be allowed by the SMTP account; defaults to SMTP_USER)
SMTP_FROM=
# Where enquiries are delivered
CONTACT_TO_EMAIL=info@kusp.com
